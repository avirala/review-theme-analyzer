# Copy this file to .streamlit/secrets.toml for local testing (gitignored —
# never commit real secrets). On Streamlit Community Cloud, set these same
# keys under your app's Settings -> Secrets instead of using this file.

APP_PASSWORD = "choose-a-password-to-share-with-your-network"
ANTHROPIC_API_KEY = "sk-ant-your-key-here"

# Soft daily cap on LLM-based analyses (shared across everyone using the
# link, since it's billed to the one key above). Requests past this fall
# back automatically to the free offline discovery instead of failing.
DAILY_LLM_QUOTA = 15
